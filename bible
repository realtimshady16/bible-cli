DEFAULT_TRANSLATION = os.environ.get("BIBLE_TRANSLATION", "web")
TRANSLATIONS = {"web": "WEB", "kjv": "KJV"}

USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def dim(t):     return c("38;2;150;140;130", t)
def gold(t):    return c("38;2;232;184;75", t)
def ref_color(t): return c("38;2;62;207;178", t)
def red(t):     return c("38;2;200;16;46", t)


