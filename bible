#!/usr/bin/env python3
"""bible — local, offline, fuzzy-findable Bible reader.

    bible john 3:16               read (WEB by default)
    bible kjv john 3:16           read another translation
    bible ps 23                   whole chapter
    bible matt 5:3-12             verse range
    bible search "still small"    full-text search (FTS5, ranked)
    bible find                    fuzzy pick a verse with fzf
    bible random
    bible --json john 3:16        machine output (for agents/editors)

Data: ~/.local/share/bible/bible.db (built by build.py in ~/Projects/bible-cli)
"""

import json
import os
import random
import re
import shutil
import sqlite3
import subprocess
import sys
