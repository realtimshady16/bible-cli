    ("2John", "2 John"), ("3John", "3 John"), ("Jude", "Jude"), ("Rev", "Revelation"),
]
NAMES = {code: name for code, name in BOOKS}
ALIASES = {
    "psalm": "Ps", "psalms": "Ps", "psa": "Ps", "song": "Song", "songofsolomon": "Song",
    "revelation": "Rev", "rev": "Rev", "phil": "Phil", "philippians": "Phil",
    "jn": "John", "jhn": "John", "mk": "Mark", "lk": "Luke", "mt": "Matt", "mat": "Matt",
    "deut": "Deut", "dt": "Deut", "ezek": "Ezek", "eze": "Ezek", "isa": "Isa",
    "jer": "Jer", "hab": "Hab", "zeph": "Zeph", "zech": "Zech", "eccl": "Eccl",
    "prov": "Prov", "pr": "Prov", "jas": "Jas", "phlm": "Phlm", "phm": "Phlm",
    "gal": "Gal", "eph": "Eph", "col": "Col", "rom": "Rom", "cor": "Cor",
    "1jn": "1John", "2jn": "2John", "3jn": "3John", "1jo": "1John", "2jo": "2John",
    "3jo": "3John", "1th": "1Thess", "2th": "2Thess", "1ti": "1Tim", "2ti": "2Tim",
    "1pe": "1Pet", "2pe": "2Pet", "1ki": "1Kgs", "2ki": "2Kgs", "1ch": "1Chr",
    "2ch": "2Chr", "1sa": "1Sam", "2sa": "2Sam", "1co": "1Cor", "2co": "2Cor",
}

# lookup: normalised token -> code
LOOKUP = {}
for code, name in BOOKS:
    for key in (code, name):
        LOOKUP[key.lower().replace(" ", "")] = code
LOOKUP.update(ALIASES)
# "1jn", "1cor", "2thess"... — numeral plus the code without its numeral
for _code, _name in BOOKS:
    if _code[0] in "123":
        LOOKUP[_code[0] + _code[1:].lower()] = _code


def resolve_book(token: str):
    key = token.lower().replace(".", "").replace(" ", "")
    if key in LOOKUP:
        return LOOKUP[key]
    # "1corinthians" / "1co" / "icorinthians"
    m = re.match(r"^(iii|ii|i|3|2|1)(.*)$", key)
    if m:
        numeral = {"i": "1", "ii": "2", "iii": "3"}.get(m.group(1), m.group(1))
        rest = m.group(2)
        for candidate in (numeral + rest, numeral + " " + rest):
            if candidate in LOOKUP:
                return LOOKUP[candidate]
        # first three letters of the name
        for code, name in BOOKS:
            if name.startswith(numeral) and name.split()[-1].lower().startswith(rest[:3]):
                return code
    for code, name in BOOKS:
        if name.lower().startswith(key) and len(key) >= 3:
            return code
    return None


REF = re.compile(r"^(?P<book>[1-3]?\s?[a-zA-Z]+\.?)\s*(?P<rest>.*)$")


def parse_ref(text: str):
    raw = text.strip()
    m = re.match(r"^(?P<book>[1-3]?\s?[A-Za-z]+\.?)\s*(?P<rest>.*)$", raw)
    if not m:
        return None
    book = resolve_book(m.group("book"))
    if not book:
        return None
    rest = m.group("rest").strip()
    chapter = verse = verse_end = None
    if rest:
        vm = re.match(r"(\d+)(?::(\d+)(?:-(\d+))?)?$", rest)
        if not vm:
            return None
        chapter = int(vm.group(1))
        if vm.group(2):
            verse = int(vm.group(2))
        if vm.group(3):
            verse_end = int(vm.group(3))
        elif verse is not None:
            verse_end = verse
    return {"book": book, "chapter": chapter, "verse": verse, "verse_end": verse_end}


def db():
    if not DB.is_file():
        sys.exit(f"no database at {DB} — run build.py first")
    con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    return con


def label(book, chapter, verse=None, verse_end=None, translation=None):
    name = NAMES.get(book, book)
    out = f"{name} {chapter}" if chapter else name
    if verse:
        out += f":{verse}"
        if verse_end:
            out += f"-{verse_end}"
    return out


def get_verses(con, ref, translation):
    sql = "SELECT code, chapter, verse, text FROM verses WHERE translation=? AND code=?"
    args = [translation, ref["book"]]
    if ref["chapter"] is not None:
        sql += " AND chapter=?"
        args.append(ref["chapter"])
    if ref["verse"] is not None:
        sql += " AND verse>=?"
        args.append(ref["verse"])
    if ref["verse_end"] is not None:
        sql += " AND verse<=?"
        args.append(ref["verse_end"])
    sql += " ORDER BY chapter, verse"
    return con.execute(sql, args).fetchall()


def print_verses(rows, translation, header=True):
    if not rows:
        print(red("  nothing found"))
        return
    if header:
        first, last = rows[0], rows[-1]
        span = label(first["code"], first["chapter"], first["verse"],
                     last["verse"] if last["verse"] != first["verse"] else None)
        print()
        print(f"  {ref_color(span)}  {dim(TRANSLATIONS.get(translation, translation))}")
        print()
    last_chapter = None
    for row in rows:
        if row["chapter"] != last_chapter:
            if last_chapter is not None:
                print()
            last_chapter = row["chapter"]
        print(f"  {dim(str(row['verse']).rjust(3))}  {row['text']}")
    print()


def search(con, query, translation, limit=20):
    rows = con.execute(
        """
        SELECT v.code, v.chapter, v.verse, v.text, bm25(verses_fts) AS rank
        FROM verses_fts JOIN verses v ON v.id = verses_fts.rowid
        WHERE verses_fts MATCH ? AND v.translation = ?
        ORDER BY rank LIMIT ?
        """,
        (fts_query(query), translation, limit),
    ).fetchall()
    return rows


def fts_query(text):
    # quote each token so punctuation in the query can't break the FTS syntax
    tokens = re.findall(r"[A-Za-z0-9']+", text)
    if not tokens:
        return '""'
    return " ".join(f'"{t}"' for t in tokens)


def cmd_read(con, args, translation, as_json):
    ref = parse_ref(" ".join(args))
    if not ref:
        print(red(f"  can't parse: {' '.join(args)}"))
        print(dim("  try: bible john 3:16   ·   bible search grace"))
        return 1
    rows = get_verses(con, ref, translation)
    if as_json:
        print(json.dumps({
            "translation": translation,
            "reference": label(ref["book"], ref["chapter"], ref["verse"], ref["verse_end"]),
            "verses": [
                {"book": NAMES.get(r["code"], r["code"]), "chapter": r["chapter"],
                 "verse": r["verse"], "text": r["text"]} for r in rows
            ],
        }, indent=2, ensure_ascii=False))
        return 0 if rows else 1
    print_verses(rows, translation)
    return 0 if rows else 1


def cmd_search(con, args, translation, as_json):
    query = " ".join(args).strip()
    if not query:
        print(red("  search what?"))
        return 1
    rows = search(con, query, translation)
    if as_json:
        print(json.dumps({
            "translation": translation, "query": query,
            "results": [
                {"reference": label(r["code"], r["chapter"], r["verse"]), "text": r["text"]}
                for r in rows
            ],
        }, indent=2, ensure_ascii=False))
        return 0
    print()
    if not rows:
        print(dim(f"  no matches for “{query}”"))
    for row in rows:
        print(f"  {ref_color(label(row['code'], row['chapter'], row['verse'])):24s}  {row['text']}")
    print()
    return 0


def cmd_random(con, translation, as_json):
    total = con.execute(
        "SELECT count(*) FROM verses WHERE translation=?", (translation,)
    ).fetchone()[0]
    row = con.execute(
        "SELECT code, chapter, verse, text FROM verses WHERE translation=? LIMIT 1 OFFSET ?",
        (translation, random.randrange(total)),
    ).fetchone()
    if as_json:
        print(json.dumps({"translation": translation,
                          "reference": label(row["code"], row["chapter"], row["verse"]),
                          "text": row["text"]}, indent=2, ensure_ascii=False))
        return 0
    print()
    print(f"  {ref_color(label(row['code'], row['chapter'], row['verse']))}")
    print(f"  {row['text']}")
    print()
    return 0


def cmd_find(con, translation):
    if not shutil.which("fzf"):
        sys.exit("fzf not installed")
    lines = [
        f"{label(row['code'], row['chapter'], row['verse'])}\t{row['text']}"
        for row in con.execute(
            """
            SELECT v.code, v.chapter, v.verse, v.text
            FROM verses v JOIN books b
              ON b.translation = v.translation AND b.code = v.code
            WHERE v.translation = ?
            ORDER BY b.ord, v.chapter, v.verse
            """,
            (translation,),
        )
    ]
    proc = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=1,2", "--prompt=bible> ",
         "--preview", "echo {} | cut -f2- | fold -s -w 80"],
        input="\n".join(lines), text=True, capture_output=True,
    )
    if proc.returncode == 0 and proc.stdout.strip():
        print(proc.stdout.split("\t", 1)[0])
    return 0


