    print()
    print(f"  {gold('bible')} — local Bible (WEB + KJV, offline)")
    print()
    print(f"  {ref_color('bible john 3:16')}          one verse        {dim('(add --json for machines)')}")
    print(f"  {ref_color('bible ps 23')}               whole chapter")
    print(f"  {ref_color('bible matt 5:3-12')}         verse range")
    print(f"  {ref_color('bible kjv john 3:16')}       another translation")
    print(f"  {ref_color('bible search still small')}  ranked full-text search")
    print(f"  {ref_color('bible find')}                fuzzy pick with fzf")
    print(f"  {ref_color('bible random')}")
    print()
    print(dim(f"  {DB}"))
    print()


def main():
    args = sys.argv[1:]
    as_json = False
    if "--json" in args:
        args.remove("--json")
        as_json = True
    if not args or args[0] in ("help", "-h", "--help"):
        usage()
        return 0
    translation = DEFAULT_TRANSLATION
    if args and args[0].lower() in TRANSLATIONS:
        translation = args.pop(0).lower()
    if not args:
        usage()
        return 0
    con = db()
    cmd = args[0].lower()
    if cmd == "search":
        return cmd_search(con, args[1:], translation, as_json)
    if cmd == "random":
        return cmd_random(con, translation, as_json)
    if cmd == "find":
        return cmd_find(con, translation)
    return cmd_read(con, args, translation, as_json)


if __name__ == "__main__":
    sys.exit(main())
